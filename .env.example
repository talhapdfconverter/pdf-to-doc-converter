# ============================================================
# PDF to Word Backend - Environment Variable Template
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to version control.
# ============================================================

# --- Adobe PDF Services credentials ---
# Get these from https://developer.adobe.com/document-services/apis/pdf-services/
# (These are Adobe's official variable names for the pdfservices-node-sdk)
PDF_SERVICES_CLIENT_ID=your_adobe_client_id_here
PDF_SERVICES_CLIENT_SECRET=your_adobe_client_secret_here

# --- Shared secret between WordPress plugin and this backend ---
# Generate a long random string (32+ characters). Example generator:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PLUGIN_SHARED_SECRET=replace_with_a_long_random_string

# --- CORS: comma-separated list of WordPress domains allowed to call this API ---
ALLOWED_ORIGINS=https://www.yourwordpresssite.com

# --- Upload / conversion limits ---
MAX_FILE_SIZE_MB=25
MAX_PDF_PAGES=200

# --- OCR defaults (can be overridden per-request by the plugin settings) ---
OCR_ENABLED=true
OCR_LOCALE=EN_US

# --- File lifecycle ---
FILE_EXPIRY_MINUTES=30

# --- Server ---
PORT=3000
NODE_ENV=production
